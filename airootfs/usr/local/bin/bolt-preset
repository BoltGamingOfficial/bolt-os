#!/usr/bin/env bash
# BOLT OS user-level preset selector. Stores preference in the user's home.
set -Eeuo pipefail
umask 077

usage() {
  cat <<'EOF'
Usage: bolt-preset {status|balanced|gaming|performance|battery|reset}

Select a reversible power-profile preset. Preferences are stored in
~/.config/bolt-os/preset.conf and survive reboots on a persistent home.
This initial implementation changes the system power profile only; it does
not disable services or claim to configure every desktop/game setting.
EOF
}

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bolt-os"
config_file="$config_dir/preset.conf"

current_preset() {
  if [[ -r "$config_file" ]]; then
    # Config is written by this tool as one validated preset value.
    IFS= read -r saved < "$config_file" || true
    case "${saved:-}" in balanced|gaming|performance|battery) printf '%s\n' "$saved"; return;; esac
  fi
  printf '%s\n' balanced
}

apply_power_profile() {
  local preset="$1" profile
  command -v powerprofilesctl >/dev/null 2>&1 || {
    printf 'Preset saved, but powerprofilesctl is unavailable; install/enable power-profiles-daemon to apply power policy.\n' >&2
    return 0
  }
  case "$preset" in
    balanced|gaming) profile=balanced ;;
    performance) profile=performance ;;
    battery) profile=power-saver ;;
    *) printf 'Invalid preset: %s\n' "$preset" >&2; return 2 ;;
  esac
  if ! powerprofilesctl list 2>/dev/null | grep -Eq "(^|[[:space:]])$profile([[:space:]]|$)"; then
    printf 'Preset saved, but power profile "%s" is not supported on this hardware.\n' "$profile" >&2
    return 0
  fi
  if ! powerprofilesctl set "$profile"; then
    printf 'Could not apply power profile "%s"; saved preference remains available.\n' "$profile" >&2
    return 1
  fi
  printf 'Applied system power profile: %s\n' "$profile"
}

case "${1:-}" in
  status)
    printf 'Saved BOLT preset: %s\n' "$(current_preset)"
    if command -v powerprofilesctl >/dev/null 2>&1; then
      printf 'Current system power profile: '
      powerprofilesctl get 2>/dev/null || printf 'unavailable\n'
    else
      printf 'Current system power profile: unavailable (powerprofilesctl missing)\n'
    fi
    ;;
  balanced|gaming|performance|battery)
    mkdir -p "$config_dir"
    printf '%s\n' "$1" > "$config_file"
    chmod 600 "$config_file"
    printf 'Saved BOLT preset: %s (%s)\n' "$1" "$config_file"
    apply_power_profile "$1"
    ;;
  reset)
    rm -f -- "$config_file"
    printf 'Removed saved BOLT preset; default is balanced.\n'
    apply_power_profile balanced
    ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
