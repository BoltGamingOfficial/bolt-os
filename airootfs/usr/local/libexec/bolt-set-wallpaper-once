#!/usr/bin/env bash
set -Eeuo pipefail

MARKER="$HOME/.config/.bolt-first-session-configured"
[[ -e "$MARKER" ]] && exit 0
mkdir -p "$HOME/.config"

# Keep the first-login experience light by opting this live user out of
# automatic content indexing. Users can switch it back on in KDE settings.
if command -v kwriteconfig6 >/dev/null 2>&1; then
  kwriteconfig6 --file "$HOME/.config/baloofilerc" \
    --group "Basic Settings" --key "Indexing-Enabled" false
fi

# Apply branding only once so a user-selected wallpaper isn't reset on login.
if /usr/bin/plasma-apply-wallpaperimage /usr/share/wallpapers/BOLT.svg; then
  touch "$MARKER"
fi
